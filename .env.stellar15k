# ============================================================================
# FundedNext MT5 Server Configuration — STELLAR 15K ACCOUNT
# ============================================================================
# Fill in your actual credentials below

# MT5 Server Details
MT5_SERVER=FundedNext-Server3
MT5_LOGIN=99999999
MT5_PASSWORD=CHANGE_ME

# MT5 Terminal Path (portable install — see MT5_PORTABLE_INSTALL.md)
# Point this to your SECOND MT5 terminal64.exe
MT5_PATH=C:\MT5_Stellar15K\terminal64.exe

# Account Configuration
ACCOUNT_SIZE=15000
ACCOUNT_CURRENCY=USD

# Risk Management
RISK_PER_TRADE=1.5
MAX_DRAWDOWN=8.0
DAILY_DRAWDOWN=3.0
DAILY_DRAWDOWN_STOP=2.0

# News Filter
NEWS_BUFFER_MINUTES=30

# Telegram Notifications (CREATE A NEW BOT via @BotFather)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Discord Notifications (optional)
DISCORD_WEBHOOK_URL=

# External Heartbeat (optional — create a separate check at healthchecks.io)
HEARTBEAT_URL=

# Account profile label (shown in Telegram messages + log file names)
ACCOUNT_LABEL=STELLAR-15K

# Indices to EXCLUDE from this account (comma-separated)
EXCLUDE_INDICES=US2000
