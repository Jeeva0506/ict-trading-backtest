# ============================================================================
# FundedNext ORB Trading Bot — .gitignore
# ============================================================================

# Environment files (contain secrets)
.env
.env.local
.env.*.local

# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
dist/
*.egg-info/
*.egg

# Virtual environments
.venv/
venv/
ENV/

# IDE
.vscode/
.idea/
*.swp
*.swo
*~

# Logs
*.log
live/logs/

# Data files (large CSV files — re-fetch from MT5 if needed)
data/raw/*.csv

# Generated reports (re-run backtest to regenerate)
reports/ict_clean/
reports/ict_clean_*/
reports/screenshots/
reports/charts/

# Trade journal (live trade data)
live/reports/

# Archive (old scripts and data)
archive/

# Jupyter
.ipynb_checkpoints/

# OS
.DS_Store
Thumbs.db

# Test artifacts
live/logs/position_state.json
live/logs/heartbeat.txt
live/logs/watchdog.lock
live/logs/news_cache.json
