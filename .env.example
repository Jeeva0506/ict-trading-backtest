# ============================================================================
# FundedNext MT5 Server Configuration
# ============================================================================
# IMPORTANT: Never commit this file to version control!
# Add .env to your .gitignore

# MT5 Server Details
MT5_SERVER=FundedNext-Server
MT5_LOGIN=12345678
MT5_PASSWORD=your_password_here

# Account Configuration
ACCOUNT_SIZE=100000
ACCOUNT_CURRENCY=USD

# Risk Management (override defaults if needed)
RISK_PER_TRADE=1.0
MAX_DRAWDOWN=10.0
DAILY_DRAWDOWN=3.0
DAILY_DRAWDOWN_STOP=2.0

# News Filter
NEWS_BUFFER_MINUTES=30

# Telegram Notifications (optional)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Discord Notifications (optional)
DISCORD_WEBHOOK_URL=
