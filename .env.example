# ============================================================================
# FundedNext ORB Trading Bot — Environment Configuration
# ============================================================================
# Copy this file to .env and fill in your actual credentials.
# IMPORTANT: .env contains secrets — NEVER commit it to version control.
#
# Strategy: Opening Range Breakout (15-min ORB)
# Indices:  SPX500 | NDX100 | GER30 | US30
# ============================================================================

# MT5 Server Details
MT5_SERVER=FundedNext-Server3
MT5_LOGIN=12345678
MT5_PASSWORD=your_password_here

# Account Configuration
ACCOUNT_SIZE=6000
ACCOUNT_CURRENCY=USD

# Risk Management
# - RISK_PER_TRADE: % risked per trade (1.5% = $90 on $6k)
# - MAX_DRAWDOWN: overall DD limit from initial balance (FundedNext = 10%, conservative = 8%)
# - DAILY_DRAWDOWN: daily DD limit from day-start equity (FundedNext = 5%)
# - DAILY_DRAWDOWN_STOP: bot stops new trades at this daily DD %
RISK_PER_TRADE=1.5
MAX_DRAWDOWN=8.0
DAILY_DRAWDOWN=3.0
DAILY_DRAWDOWN_STOP=2.0

# News Filter (minutes to block around high-impact events)
NEWS_BUFFER_MINUTES=30

# Telegram Notifications (optional but recommended)
# Create bot via @BotFather, get chat_id via @userinfobot
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Discord Notifications (optional)
DISCORD_WEBHOOK_URL=
